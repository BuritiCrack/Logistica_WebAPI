<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center">
            <!-- Información del usuario mejorada -->
            <div class="user-profile-container me-3">
                <!-- Avatar del usuario con foto o icono por defecto -->
                <div class="user-avatar">
                    @if (!string.IsNullOrEmpty(photoUser))
                    {
                        <div class="user-photo-container">
                            <img src="@photoUser"
                                 alt="Foto de perfil de @context.User.Identity!.Name"
                                 class="user-photo"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="user-photo-fallback" style="display: none;">
                                <i class="fa fa-user"></i>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="user-photo-placeholder">
                            <i class="fa fa-user-circle"></i>
                        </div>
                    }
                </div>

                <!-- Detalles del usuario -->
                <div class="user-details">
                    <span class="user-name">
                        @{
                            var userName = context.User.FindFirst("FirstName")?.Value;
                        }
                        <a href="EditUser" class="nav-link btn btn-link" title="@userName">
                            @userName
                        </a>
                    </span>
                </div>
            </div>

            <!-- Botón de cerrar sesión mejorado -->
            <a href="Logout" class="btn btn-logout">
                <i class="fa fa-sign-out-alt me-1"></i>
                <span>Cerrar Sesión</span>
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex align-items-center gap-2">
            <!-- Botón de registro -->
            <a href="Register" class="btn btn-success btn-sm">
                <i class="fa fa-user-plus me-1"></i>
                Registro
            </a>

            <!-- Botón de iniciar sesión -->
            <a @onclick="@(() => ShowModal())" class="btn btn-primary btn-sm">
                <i class="fa fa-sign-in-alt me-1"></i>
                Iniciar Sesión
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>