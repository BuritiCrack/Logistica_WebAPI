<AuthorizeView>
    <Authorized>
        <div class="user-card">
            <!-- Contenedor del avatar -->
            <div class="user-avatar-wrapper">
                @if (!string.IsNullOrEmpty(photoUser))
                {
                    <div class="avatar-container">
                        <img src="@photoUser"
                        alt="Foto de perfil de @context.User.Identity!.Name"
                        class="avatar-image"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="avatar-fallback" style="display: none;">
                            <i class="fa fa-user-circle"></i>
                        </div>
                    </div>
                }
                else
                {
                    <div class="avatar-default">
                        <i class="fa fa-user-circle"></i>
                    </div>
                }
            </div>

            <!-- Información del usuario -->
            <div class="user-info">
                @{
                    var userName = context.User.FindFirst("FirstName")?.Value;
                    
                }
                <h3 class="user-name">Hola, @userName</h3>
                <a href="EditUser" class="edit-profile-btn">
                    <i class="fa fa-pencil-alt"></i> Editar perfil
                </a>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex align-items-center gap-2">
            <!-- Botón de registro -->
            <a href="Register" class="btn btn-success btn-sm">
                <i class="fa fa-user-plus me-1"></i>
                Registro
            </a>

            <!-- Botón de iniciar sesión -->
            <a @onclick="@(() => ShowModal())" class="btn btn-primary btn-sm">
                <i class="fa fa-sign-in-alt me-1"></i>
                Iniciar Sesión
            </a>
        </div>
    </NotAuthorized>
</AuthorizeView>