@if (TotalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            @foreach (var link in links)
            {
                <li class="page-item @(link.IsCurrent ? "active" : "") @(!link.IsEnable ? "disabled" : "")">
                    @if (link.IsEnable)
                    {
                        <button class="page-link" @onclick="() => InternalSelectedPage(link)">
                            @link.Text
                        </button>
                    }
                    else
                    {
                        <span class="page-link">@link.Text</span>
                    }
                </li>
            }
        </ul>
    </nav>
}
