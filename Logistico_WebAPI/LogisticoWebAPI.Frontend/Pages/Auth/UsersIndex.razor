@page "/users"

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>
            <i class="fa fa-users"></i> Gestión de Usuarios
        </h3>
    </div>

    <AuthorizeView Roles="Admin">
        <Authorized>
            @if (Users == null)
            {
                <Loading />
            }
            else if (!Users.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fa fa-info-circle fa-3x mb-3"></i>
                    <h4>No hay usuarios registrados</h4>
                    <p>Aún no se han registrado usuarios en el sistema.</p>
                </div>
            }
            else
            {
                <!-- Estadísticas rápidas -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h3>@Users.Count</h3>
                                        <p class="mb-0">Total Usuarios</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-users fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h3>@Users.Count(u => u.IsActive == true)</h3>
                                        <p class="mb-0">Usuarios Activos</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-user-check fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h3>@Users.Count(u => u.IsActive != true)</h3>
                                        <p class="mb-0">Usuarios Inactivos</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-user-times fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <h3>@Users.Count(u => u.UserType == UserType.Admin)</h3>
                                        <p class="mb-0">Administradores</p>
                                    </div>
                                    <div class="align-self-center">
                                        <i class="fa fa-user-shield fa-2x"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Sección de Filtro -->
                <GenericFilter PlaceHolder="Busca por nombre o cedula..."
                               TexFromFilter="Buscar Usuarios"
                               @bind-TexToFilter="Filter"
                               Callback=@OnFilterChangedAsync />
                <!-- Lista de usuarios -->
                <div class="row">
                    @foreach (var user in Users!)
                    {
                        <div class="col-lg-6 col-xl-4 mb-4">
                            <div class="card user-card h-100">
                                <div class="card-body">
                                    <!-- Header del usuario -->
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="user-avatar me-3">
                                            @if (!string.IsNullOrEmpty(user.Photo))
                                            {
                                                <img src="@user.Photo" alt="@user.FullName" class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background-color: #e9ecef;">
                                                    <i class="fa fa-user fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="flex-grow-1">
                                            <h5 class="card-title mb-1">@user.FullName</h5>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (user.UserType == UserType.Admin)
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="fa fa-shield-alt"></i> Admin
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="fa fa-user"></i> Usuario
                                                    </span>
                                                }
                                                
                                                @if (user.IsActive == true)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactivo</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Información del usuario -->
                                    <div class="user-info">
                                        
                                        <div class="row text-sm mb-2">
                                            <div class="col-4"><strong>Documento:</strong></div>
                                            <div class="col-8">@user.Document</div>
                                        </div>
                                        <div class="row text-sm mb-2">
                                            <div class="col-4"><strong>Email:</strong></div>
                                            <div class="col-8">
                                                <small>@user.Email</small>
                                                @if (user.EmailConfirmed)
                                                {
                                                    <i class="fa fa-check-circle text-success ms-1" title="Email confirmado"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-exclamation-circle text-warning ms-1" title="Email no confirmado"></i>
                                                }
                                            </div>
                                        </div>
                                        <div class="row text-sm mb-2">
                                            <div class="col-4"><strong>Teléfono:</strong></div>
                                            <div class="col-8">@(user.PhoneNumber ?? "No especificado")</div>
                                        </div>
                                        <div class="row text-sm mb-2">
                                            <div class="col-4"><strong>Género:</strong></div>
                                            <div class="col-8">@user.Gender.GetDescription()</div>
                                        </div>
                                        <div class="row text-sm mb-2">
                                            <div class="col-4"><strong>Edad:</strong></div>
                                            <div class="col-8">@user.Age Años</div>
                                        </div>
                                        @if (user.City != null)
                                        {
                                            <div class="row text-sm mb-2">
                                                <div class="col-4"><strong>Ubicación:</strong></div>
                                                <div class="col-8">
                                                    <i class="fa fa-map-marker-alt text-muted"></i>
                                                    @user.City.Name, @user.City.State?.Name
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Footer con acciones -->
                                <div class="card-footer bg-transparent">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="fa fa-calendar"></i>
                                            Usuario desde: @(user.LockoutEnd?.ToString("dd/MM/yyyy") ?? "N/A")
                                        </small>
                                        <div class="btn-group">
                                            <a class="btn btn-outline-primary btn-sm" href="/user/details/@user.Id"
                                                    title="Ver detalles">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <a class="btn btn-outline-warning btn-sm" href="/EditUser" title="Editar usuario">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            @if (user.IsActive == true)
                                            {
                                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeactivateUser(user)"
                                                    title="Desactivar usuario">
                                                    <i class="fa fa-user-times"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-success btn-sm" @onclick="() => DeactivateUser(user)"
                                                    title="Activar usuario">
                                                    <i class="fa fa-user-check"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            OnPageChanged="OnPageChangedAsync" />
            }
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-danger text-center">
                <i class="fa fa-lock fa-3x mb-3"></i>
                <h4>Acceso Denegado</h4>
                <p>Solo los administradores pueden ver la lista de usuarios.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<style>
    .user-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    
    .user-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    
    .avatar-placeholder {
        border: 2px dashed #dee2e6;
    }
    
    .text-sm {
        font-size: 0.875rem;
    }
    
    .user-info .row {
        border-bottom: 1px solid #f8f9fa;
        padding: 0.25rem 0;
    }
    
    .user-info .row:last-child {
        border-bottom: none;
    }
    
    .btn-group .btn {
        border-radius: 0.25rem !important;
        margin-left: 2px;
    }
</style>

