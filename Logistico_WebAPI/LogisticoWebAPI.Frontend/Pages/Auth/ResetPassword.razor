@page "/api/accounts/ResetPassword"

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-header text-center">
                <h4 class="card-title mb-0">
                    <i class="fa fa-unlock-alt"></i> Restablecer Contraseña
                </h4>
            </div>

            <div class="card-body">
                <div class="text-center mb-4">
                    <p class="text-muted">
                        Ingresa tu email y tu nueva contraseña para restablecer el acceso a tu cuenta.
                    </p>
                </div>

                <EditForm Model="resetPasswordDTO" OnValidSubmit="ChangePasswordAsync">
                    <DataAnnotationsValidator />

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fa fa-envelope"></i> Email:
                        </label>
                        <InputText type="email"
                                   class="form-control"
                                   @bind-Value="resetPasswordDTO.Email"
                                   placeholder="correo@ejemplo.com" />
                        <ValidationMessage For="@(() => resetPasswordDTO.Email)" />
                    </div>

                    <!-- Nueva contraseña -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fa fa-lock"></i> Nueva contraseña:
                        </label>
                        <InputText type="password"
                                   class="form-control"
                                   @bind-Value="resetPasswordDTO.Password"
                                   placeholder="Ingrese su nueva contraseña" />
                        <ValidationMessage For="@(() => resetPasswordDTO.Password)" />
                    </div>

                    <!-- Confirmar nueva contraseña -->
                    <div class="mb-4">
                        <label class="form-label">
                            <i class="fa fa-check"></i> Confirmar nueva contraseña:
                        </label>
                        <InputText type="password"
                                   class="form-control"
                                   @bind-Value="resetPasswordDTO.ConfirmPassword"
                                   placeholder="Confirme su nueva contraseña" />
                        <ValidationMessage For="@(() => resetPasswordDTO.ConfirmPassword)" />
                    </div>

                    <!-- Botón de Restablecer Contraseña -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary" disabled="@loading">
                            @if (loading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Restableciendo...</span>
                            }
                            else
                            {
                                <i class="fa fa-unlock-alt me-1"></i>
                                <span>Restablecer Contraseña</span>
                            }
                        </button>
                    </div>

                    <!-- Enlaces adicionales -->
                    <div class="text-center">
                        <p class="mb-0">
                            ¿Recordaste tu contraseña?
                            <a href="/Login" class="text-decoration-none">
                                <i class="fa fa-sign-in-alt"></i> Iniciar sesión
                            </a>
                        </p>
                    </div>

                    <div class="text-center mt-2">
                        <p class="mb-0">
                            ¿No tienes cuenta?
                            <a href="/Register" class="text-decoration-none">
                                <i class="fa fa-user-plus"></i> Regístrate aquí
                            </a>
                        </p>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Información adicional -->
        <div class="text-center mt-3">
            <small class="text-muted">
                <i class="fa fa-shield-alt"></i>
                Tu nueva contraseña debe tener entre 6 y 20 caracteres
            </small>
        </div>
    </div>
</div>

<!-- Estilos adicionales para el formulario -->
<style>
    .card {
        border: none;
        border-radius: 15px;
    }

    .card-header {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        color: white;
        border-radius: 15px 15px 0 0 !important;
        padding: 1.5rem;
    }

    .form-control:focus {
        border-color: #17a2b8;
        box-shadow: 0 0 0 0.2rem rgba(23, 162, 184, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        border: none;
        padding: 12px;
        font-weight: 500;
    }

    .btn-primary:hover:not(:disabled) {
        background: linear-gradient(135deg, #138496 0%, #117a8b 100%);
        transform: translateY(-2px);
        transition: all 0.3s ease;
    }

    .btn-primary:disabled {
        opacity: 0.7;
        transform: none;
    }

    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
    }
</style>
