@page "/Login"

<!-- Overlay de Loading -->
@if(isLoading)
{
    <div class="loading-overlay">
        <div class="loading-content">
            <div class="loading-spinner">
                <div class="spinner"></div>
            </div>
            <div class="loading-text">
                <i class="fa fa-lock"></i> Verificando credenciales...
            </div>
        </div>
    </div>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header text-center">
                <h4 class="card-title mb-0">
                    <i class="fa fa-sign-in-alt"></i> Iniciar Sesión
                </h4>
            </div>

            <div class="card-body">
                <EditForm Model="loginDTO" OnValidSubmit="LoginAsync">
                    <DataAnnotationsValidator />

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="fa fa-envelope"></i> Email:
                        </label>
                        <InputText type="email" 
                                   class="form-control" 
                                   @bind-Value="loginDTO.Email" 
                                   placeholder="correo@ejemplo.com" />
                        <ValidationMessage For="@(() => loginDTO.Email)" />
                    </div>

                    <!-- Contraseña -->
                    <div class="mb-4">
                        <label class="form-label">
                            <i class="fa fa-lock"></i> Contraseña:
                        </label>
                        <InputText type="password" 
                                   class="form-control" 
                                   @bind-Value="loginDTO.Password" 
                                   placeholder="Ingrese su contraseña" />
                        <ValidationMessage For="@(() => loginDTO.Password)" />
                    </div>

                    <!-- Botón de Login -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary" disabled="@isLoading">
                            <i class="fa fa-sign-in-alt"></i> Iniciar Sesión
                        </button>
                        <!--Boton de CloseModalAsync para que el usuario pueda cancelar-->
                        <button type="button" class="btn btn-gradient-secondary" @onclick="CloseModalAsync" disabled="@isLoading">
                            <i class="fa fa-times"></i> Cancelar
                        </button>
                    </div>

                    <!-- Enlaces adicionales -->
                    <div class="text-center">
                        <p class="mb-0">
                            ¿No tienes cuenta?
                            <a href="/Register" class="text-decoration-none">
                                <i class="fa fa-user-plus"></i> Regístrate aquí
                            </a>
                        </p>
                    </div>

                    <div class="text-center mt-2">
                        <p class="mb-0">
                            ¿Olvidaste tu contraseña?
                            <a href="/ForgotPassword" class="text-decoration-none">
                                <i class="fa fa-question-circle"></i> Recuperar contraseña
                            </a>
                        </p>
                    </div>

                    <div class="text-center mt-2">
                        <p class="mb-0">
                            ¿No te ha llegado el correo?
                            <a href="/ResendToken" class="text-decoration-none">
                                <i class="fa fa-paper-plane"></i> Reenviar activación
                            </a>
                        </p>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Información adicional -->
        <div class="text-center mt-3">
            <small class="text-muted">
                <i class="fa fa-shield-alt"></i> 
                Tu información está protegida y segura
            </small>
        </div>
    </div>
</div>

