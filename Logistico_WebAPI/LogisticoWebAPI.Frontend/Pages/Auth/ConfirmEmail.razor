@page "/api/accounts/ConfirmEmail"

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-header text-center">
                <h4 class="card-title mb-0">
                    <i class="fa fa-envelope-open"></i> Confirmación de Email
                </h4>
            </div>

            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="fa fa-check-circle fa-4x text-success"></i>
                    </div>
                    <p class="text-muted">
                        Haz clic en el botón de abajo para confirmar tu dirección de correo electrónico y activar tu cuenta.
                    </p>
                </div>

                <!-- Botón de confirmación -->
                <div class="d-grid mb-3">
                    <button type="button" class="btn btn-success" @onclick="ConfirmAccountAsync">
                        <i class="fa fa-check me-1"></i>
                        Confirmar Email
                    </button>
                </div>

                <!-- Enlaces adicionales -->
                <div class="text-center">
                    <p class="mb-0">
                        ¿Problemas con la confirmación? 
                        <a href="/ResendToken" class="text-decoration-none">
                            <i class="fa fa-paper-plane"></i> Reenviar correo
                        </a>
                    </p>
                </div>

                <div class="text-center mt-2">
                    <p class="mb-0">
                        <a href="/Login" class="text-decoration-none">
                            <i class="fa fa-sign-in-alt"></i> Ir al login
                        </a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Información adicional -->
        <div class="text-center mt-3">
            <small class="text-muted">
                <i class="fa fa-info-circle"></i> 
                Tu cuenta se activará inmediatamente después de la confirmación
            </small>
        </div>
    </div>
</div>
