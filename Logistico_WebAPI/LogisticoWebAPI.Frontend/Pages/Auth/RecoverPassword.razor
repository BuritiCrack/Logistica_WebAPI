@page "/ForgotPassword"

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow">
            <div class="card-header text-center">
                <h4 class="card-title mb-0">
                    <i class="fa fa-key"></i> Recuperar Contraseña
                </h4>
            </div>

            <div class="card-body">
                @if (loading)
                {
                    <!-- Estado de carga similar al Loading.razor -->
                    <div class="d-flex justify-content-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Enviando correo...</span>
                        </div>
                    </div>
                    <p class="text-center text-muted mt-3">
                        Enviando instrucciones de recuperación...
                    </p>
                }
                else
                {
                    <div class="text-center mb-4">
                        <p class="text-muted">
                            Ingresa tu dirección de correo electrónico y te enviaremos
                            las instrucciones para recuperar tu contraseña.
                        </p>
                    </div>

                    <EditForm Model="emailDTO" OnValidSubmit="SendRecoverPasswordEmailTokenAsync">
                        <DataAnnotationsValidator />

                        <!-- Email -->
                        <div class="mb-4">
                            <label class="form-label">
                                <i class="fa fa-envelope"></i> Correo electrónico:
                            </label>
                            <InputText type="email"
                                       class="form-control"
                                       @bind-Value="emailDTO.Email"
                                       placeholder="correo@ejemplo.com" />
                            <ValidationMessage For="@(() => emailDTO.Email)" />
                        </div>

                        <!-- Botón de recuperación -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-warning" disabled="@loading">
                                <i class="fa fa-key me-1"></i>
                                Enviar Instrucciones
                            </button>
                        </div>

                        <!-- Enlaces adicionales -->
                        <div class="text-center">
                            <p class="mb-0">
                                ¿Recordaste tu contraseña?
                                <a @onclick="(() => ShowLogin())" class="text-decoration-none">
                                    <i class="fa fa-sign-in-alt"></i> Iniciar sesión
                                </a>
                            </p>
                        </div>

                        <div class="text-center mt-2">
                            <p class="mb-0">
                                ¿No tienes cuenta?
                                <a href="/Register" class="text-decoration-none">
                                    <i class="fa fa-user-plus"></i> Regístrate aquí
                                </a>
                            </p>
                        </div>

                        <div class="text-center mt-2">
                            <p class="mb-0">
                                ¿No te ha llegado el correo de activación?
                                <a href="/ResendToken" class="text-decoration-none">
                                    <i class="fa fa-paper-plane"></i> Reenviar activación
                                </a>
                            </p>
                        </div>
                    </EditForm>
                }
            </div>
        </div>

        <!-- Información adicional -->
        <div class="text-center mt-3">
            <small class="text-muted">
                <i class="fa fa-info-circle"></i>
                Revisa tu bandeja de entrada y carpeta de spam
            </small>
        </div>
    </div>
</div>

<!-- Estilos adicionales para el formulario -->
<style>
    .card {
        border: none;
        border-radius: 15px;
    }
    
    .card-header {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
        color: white;
        border-radius: 15px 15px 0 0 !important;
        padding: 1.5rem;
    }
    
    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }
    
    .btn-warning {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
        border: none;
        padding: 12px;
        font-weight: 500;
        color: white;
    }
    
    .btn-warning:hover:not(:disabled) {
        background: linear-gradient(135deg, #e0a800 0%, #ea6a00 100%);
        transform: translateY(-2px);
        transition: all 0.3s ease;
        color: white;
    }
    
    .btn-warning:disabled {
        opacity: 0.7;
        transform: none;
    }
    
    .spinner-border {
        width: 3rem;
        height: 3rem;
    }
</style>
