@page "/mycredential"

<PageTitle>TalentStage - Mi Credencial Digital</PageTitle>

<div class="credential-container">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            
            <!-- Encabezado de la credencial -->
            <div class="credential-header mb-4">
                <div class="d-flex align-items-center">
                    <div class="credential-icon">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <div class="ms-3">
                        <h2 class="credential-title mb-1">Mi Credencial Digital</h2>
                        <p class="credential-subtitle mb-0">Presenta este código QR en los eventos</p>
                    </div>
                </div>
            </div>

            @if (isLoading)
            {
                <Loading />
            }
            else if (user != null)
            {
                <!-- Tarjeta principal de credencial -->
                <div class="credential-card">
                    <!-- Header de la tarjeta -->
                    <div class="credential-card-header">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar">
                                        @if (!string.IsNullOrEmpty(user.Photo))
                                        {
                                            <img src="@user.Photo" alt="@user.FullName" class="avatar-img">
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="ms-3">
                                        <h4 class="user-name">@user.FullName</h4>
                                        <p class="user-document">Documento: @user.Document</p>
                                        <div class="user-status">
                                            @if (user.IsActive)
                                            {
                                                <span class="status-badge active">
                                                    <i class="fas fa-check-circle"></i> Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive">
                                                    <i class="fas fa-exclamation-circle"></i> Inactivo
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Código QR Central -->
                    <div class="qr-section">
                        <div class="qr-container">
                            @if (!string.IsNullOrEmpty(user.QrCode))
                            {
                                <div class="qr-code">
                                    <img src="@user.QrCode" alt="Código QR de @user.FullName" class="qr-image">
                                </div>
                                <div class="qr-instructions">
                                    <h5><i class="fas fa-mobile-alt"></i> Instrucciones de uso:</h5>
                                    <ol class="instruction-list">
                                        <li>Presenta este código QR al llegar al evento</li>
                                        <li>El organizador lo escaneará para confirmar tu asistencia</li>
                                        <li>Mantén tu teléfono con batería suficiente</li>
                                        <li>Si tienes problemas, muestra tu documento de identidad</li>
                                    </ol>
                                </div>
                            }
                            else
                            {
                                <div class="qr-error">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <h5>Código QR no disponible</h5>
                                    <p>Tu código QR se está generando. Por favor, actualiza la página en unos minutos.</p>
                                    <button class="btn btn-primary">
                                        <i class="fas fa-refresh"></i> Actualizar
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Footer TalentStage (reemplaza el footer anterior) -->
                    <div class="talentstage-footer">
                        <div class="footer-brand">
                            <div class="brand-icon">
                                <i class="fas fa-star"></i>
                            </div>
                            <h4 class="brand-title">TalentStage</h4>
                            <p class="brand-tagline">Tu plataforma de gestión de eventos y talento</p>
                        </div>
                        <div class="footer-info">
                            <div class="footer-copyright text-center">
                                <small>&copy; @DateTime.Now.Year TalentStage</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    No se pudo cargar la información del usuario. Por favor, intenta nuevamente.
                </div>
            }
        </div>
    </div>
</div>




