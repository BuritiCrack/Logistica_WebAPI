@page "/Register"

<div class="row justify-content-center">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="fa fa-user-plus"></i> Registro de Usuario
                </h4>
            </div>

            <div class="card-body">
                <EditForm Model="userDTO" OnValidSubmit="CreateUserAsync">
                    <DataAnnotationsValidator />

                    <!-- Información Personal -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fa fa-user"></i> Información Personal
                            </h5>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Documento -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Documento:</label>
                            <InputText class="form-control" @bind-Value="userDTO.Document" />
                            <ValidationMessage For="@(() => userDTO.Document)" />
                        </div>

                        <!-- Email -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email:</label>
                            <InputText type="email" class="form-control" @bind-Value="userDTO.Email" />
                            <ValidationMessage For="@(() => userDTO.Email)" />
                        </div>
                    </div>

                    <div class="row">
                        <!-- Nombres -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombres:</label>
                            <InputText class="form-control" @bind-Value="userDTO.FirstName" />
                            <ValidationMessage For="@(() => userDTO.FirstName)" />
                        </div>

                        <!-- Apellidos -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Apellidos:</label>
                            <InputText class="form-control" @bind-Value="userDTO.LastName" />
                            <ValidationMessage For="@(() => userDTO.LastName)" />
                        </div>
                    </div>

                    <div class="row">
                        <!-- Teléfono -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teléfono:</label>
                            <InputText class="form-control" @bind-Value="userDTO.PhoneNumber" />
                            <ValidationMessage For="@(() => userDTO.PhoneNumber)" />
                        </div>

                        <!-- Dirección -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Dirección:</label>
                            <InputText class="form-control" @bind-Value="userDTO.Address" />
                            <ValidationMessage For="@(() => userDTO.Address)" />
                        </div>
                    </div>

                    <div class="row">
                        <!-- Género -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Género:</label>
                            <InputSelect class="form-select" @bind-Value="userDTO.Gender">
                                <option value="">Seleccione...</option>
                                @foreach (var gender in Enum.GetValues<GenderEnum>())
                                {
                                    <option value="@gender">@gender.GetDescription()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => userDTO.Gender)" />
                        </div>

                        <!-- Altura -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Altura (cm):</label>
                            <InputText class="form-control" @bind-Value="userDTO.Height" />
                            <ValidationMessage For="@(() => userDTO.Height)" />
                        </div>

                        <!-- Edad -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Edad:</label>
                            <InputText class="form-control" @bind-Value="userDTO.Age" />
                            <ValidationMessage For="@(() => userDTO.Age)" />
                        </div>
                    </div>

                    <!-- Información Profesional -->
                    <div class="row mb-3 mt-4">
                        <div class="col-12">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fa fa-briefcase"></i> Información Profesional
                            </h5>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Experiencia -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Experiencia:</label>
                            <InputText class="form-control" @bind-Value="userDTO.Experience" />
                            <ValidationMessage For="@(() => userDTO.Experience)" />
                        </div>

                        <!-- Estados -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Departamento:</label>
                            <select class="form-select" @onchange="StateChangedAsync">
                                <option value="0">Seleccione...</option>
                                @if (states != null)
                                {
                                    @foreach (var state in states)
                                    {
                                        <option value="@state.Id">@state.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Ciudades -->
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Ciudad:</label>
                            <InputSelect class="form-select" @bind-Value="userDTO.CityId">
                                <option value="0">Seleccione...</option>
                                @if (cities != null)
                                {
                                    @foreach (var city in cities)
                                    {
                                        <option value="@city.Id">@city.Name</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => userDTO.CityId)" />
                        </div>
                    </div>

                    <!-- Habilidades -->
                    <div class="mb-3">
                        <label class="form-label">Habilidades:</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="userDTO.Skills" />
                        <ValidationMessage For="@(() => userDTO.Skills)" />
                    </div>

                    <!-- Información Bancaria -->
                    <div class="row mb-3 mt-4">
                        <div class="col-12">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fa fa-university"></i> Información Bancaria
                            </h5>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Banco -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Banco:</label>
                            <InputSelect class="form-select" @bind-Value="userDTO.Bank">
                                <option value="">Seleccione...</option>
                                @foreach (var bank in Enum.GetValues<BankName>())
                                {
                                    <option value="@bank">@bank.ToString()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => userDTO.Bank)" />
                        </div>

                        <!-- Tipo de Cuenta -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Tipo de Cuenta:</label>
                            <InputSelect class="form-select" @bind-Value="userDTO.AccountType">
                                <option value="">Seleccione...</option>
                                @foreach (var accountType in Enum.GetValues<AccountType>())
                                {
                                    <option value="@accountType">@accountType.GetDisplayName()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => userDTO.AccountType)" />
                        </div>

                        <!-- Número de Cuenta -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Número de Cuenta:</label>
                            <InputText class="form-control" @bind-Value="userDTO.AccountNumber" />
                            <ValidationMessage For="@(() => userDTO.AccountNumber)" />
                        </div>
                    </div>

                    <!-- Información de Salud -->
                    <div class="row mb-3 mt-4">
                        <div class="col-12">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fa fa-medkit"></i> Información de Salud
                            </h5>
                        </div>
                    </div>

                    <div class="row">
                        <!-- EPS -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">EPS:</label>
                            <InputText class="form-control" @bind-Value="userDTO.Eps" />
                            <ValidationMessage For="@(() => userDTO.Eps)" />
                        </div>

                        <!-- Fondo de Pensiones -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fondo de Pensiones:</label>
                            <InputText class="form-control" @bind-Value="userDTO.PensionFund" />
                            <ValidationMessage For="@(() => userDTO.PensionFund)" />
                        </div>
                    </div>

                    <!-- Seguridad -->
                    <div class="row mb-3 mt-4">
                        <div class="col-12">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fa fa-lock"></i> Seguridad
                            </h5>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Contraseña -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contraseña:</label>
                            <InputText type="password" class="form-control" @bind-Value="userDTO.Password" />
                            <ValidationMessage For="@(() => userDTO.Password)" />
                        </div>

                        <!-- Confirmar Contraseña -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Confirmar Contraseña:</label>
                            <InputText type="password" class="form-control" @bind-Value="userDTO.PasswordConfirm" />
                            <ValidationMessage For="@(() => userDTO.PasswordConfirm)" />
                        </div>
                    </div>

                    <!-- Foto (Opcional) -->
                    <div class="mb-4">
                        <h5 class="text-primary border-bottom pb-2 mt-4">
                            <i class="fa fa-camera"></i> Foto de Perfil
                        </h5>
                        <InputImg Label="Seleccionar Foto"
                                  ImageURL="@imageUrl"
                                  ImageSelected="ImageSelected" />
                        <small class="text-muted">Formatos permitidos: JPG, JPEG, PNG</small>
                    </div>

                    <!-- Botones -->
                    <div class="d-flex justify-content-between">
                        <a href="/" class="btn btn-secondary">
                            <i class="fa fa-arrow-left"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-user-plus"></i> Registrarse
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true"></span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
