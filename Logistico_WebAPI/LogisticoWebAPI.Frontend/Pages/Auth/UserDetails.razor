@page "/user/details/{Id}"

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/users" class="text-decoration-none">
                            <i class="fa fa-users me-1"></i>Usuarios
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Detalles del Usuario
                    </li>
                </ol>
            </nav>
            <h3 class="mb-0">
                <i class="fa fa-user-circle"></i> 
                @if (User != null)
                {
                    @User.FullName
                }
                else
                {
                    <text>Detalles del Usuario</text>
                }
            </h3>
        </div>
        
        <div class="d-flex gap-2">
            <button class="btn btn-secondary" @onclick="GoBack">
                <i class="fa fa-arrow-left me-1"></i>
                Volver
            </button>
            @if (User != null)
            {
                <a class="btn btn-outline-warning" href="/user/edituser/@User.Id">
                    <i class="fa fa-edit me-1"></i>
                    Editar
                </a>
            }
        </div>
    </div>

    @if (IsLoading)
    {
        <Loading />
    }
    else if (User == null)
    {
        <div class="alert alert-warning text-center">
            <i class="fa fa-exclamation-triangle fa-3x mb-3"></i>
            <h4>Usuario no encontrado</h4>
            <p>El usuario solicitado no existe o no tienes permisos para verlo.</p>
        </div>
    }
    else
    {
        <!-- Header del Usuario con Foto y Estados -->
        <div class="user-header-card mb-4">
            <div class="row align-items-center">
                <div class="col-auto">
                    @if (!string.IsNullOrEmpty(User.Photo))
                    {
                        <img src="@User.Photo" alt="@User.FullName" class="user-avatar-large">
                    }
                    else
                    {
                        <div class="user-avatar-large avatar-placeholder">
                            <i class="fa fa-user fa-3x text-muted"></i>
                        </div>
                    }
                </div>
                <div class="col">
                    <h4 class="mb-2">@User.FullName</h4>
                    <div class="user-badges mb-3">
                        @if (User.UserType == UserType.Admin)
                        {
                            <span class="badge badge-admin">
                                <i class="fa fa-shield-alt me-1"></i>Administrador
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-user">
                                <i class="fa fa-user me-1"></i>Usuario
                            </span>
                        }
                        
                        @if (User.IsActive)
                        {
                            <span class="badge badge-active">
                                <i class="fa fa-check-circle me-1"></i>Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">
                                <i class="fa fa-times-circle me-1"></i>Inactivo
                            </span>
                        }
                        
                        @if (User.EmailConfirmed)
                        {
                            <span class="badge badge-verified">
                                <i class="fa fa-check me-1"></i>Verificado
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-unverified">
                                <i class="fa fa-exclamation-triangle me-1"></i>Sin verificar
                            </span>
                        }
                    </div>
                    <div class="user-quick-info">
                        <span class="info-item">
                            <i class="fa fa-envelope text-muted me-1"></i>
                            @User.Email
                        </span>
                        <span class="info-item">
                            <i class="fa fa-phone text-muted me-1"></i>
                            @(User.PhoneNumber ?? "No especificado")
                        </span>
                        @if (User.City != null)
                        {
                            <span class="info-item">
                                <i class="fa fa-map-marker-alt text-muted me-1"></i>
                                @User.City.Name, @User.City.State?.Name
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Grid de Información Compacta -->
        <div class="row g-4">
            <!-- Información Personal -->
            <div class="col-lg-6">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa fa-user text-primary"></i>
                        <span>Información Personal</span>
                    </div>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">Documento:</span>
                            <span class="value">@User.Document</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Nombres:</span>
                            <span class="value">@User.FirstName</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Apellidos:</span>
                            <span class="value">@User.LastName</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Género:</span>
                            <span class="value">@User.Gender.GetDescription()</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Edad:</span>
                            <span class="value">@User.Age años</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Altura:</span>
                            <span class="value">@User.Height cm</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información de Contacto -->
            <div class="col-lg-6">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa fa-address-book text-info"></i>
                        <span>Contacto y Ubicación</span>
                    </div>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">Email:</span>
                            <span class="value">@User.Email</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Teléfono:</span>
                            <span class="value">@(User.PhoneNumber ?? "No especificado")</span>
                        </div>
                        <div class="info-item full-width">
                            <span class="label">Dirección:</span>
                            <span class="value">@User.Address</span>
                        </div>
                        @if (User.City != null)
                        {
                            <div class="info-item">
                                <span class="label">Ciudad:</span>
                                <span class="value">@User.City.Name</span>
                            </div>
                            <div class="info-item">
                                <span class="label">Departamento:</span>
                                <span class="value">@User.City.State?.Name</span>
                            </div>
                        }
                        @if (User.LockoutEnd.HasValue)
                        {
                            <div class="info-item">
                                <span class="label">Registro:</span>
                                <span class="value">@User.LockoutEnd.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Información Profesional -->
            <div class="col-lg-6">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa fa-briefcase text-success"></i>
                        <span>Información Profesional</span>
                    </div>
                    <div class="info-grid">
                        <div class="info-item full-width">
                            <span class="label">Experiencia:</span>
                            <span class="value text-truncate">@User.Experience</span>
                        </div>
                        <div class="info-item full-width">
                            <span class="label">Habilidades:</span>
                            <span class="value text-truncate">@User.Skills</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información Bancaria -->
            <div class="col-lg-6">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa fa-university text-warning"></i>
                        <span>Información Bancaria</span>
                    </div>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">Banco:</span>
                            <span class="value">@User.Bank.ToString()</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Tipo:</span>
                            <span class="value">@User.AccountType.GetDisplayName()</span>
                        </div>
                        <div class="info-item full-width">
                            <span class="label">Número:</span>
                            <span class="value">@User.AccountNumber</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información de Seguridad Social -->
            <div class="col-lg-12">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa fa-medkit text-danger"></i>
                        <span>Seguridad Social y Salud</span>
                    </div>
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="label">EPS:</span>
                            <span class="value">@User.Eps</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Fondo de Pensiones:</span>
                            <span class="value">@User.PensionFund</span>
                        </div>
                        @if (User.EventUsers != null && User.EventUsers.Any())
                        {
                            <div class="info-item">
                                <span class="label">Eventos Registrados:</span>
                                <span class="value">
                                    <span class="badge bg-primary">@User.EventUsers.Count</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
