@page "/events/applications/{Id:int}"


<!-- Sección de Filtro -->
<GenericFilter PlaceHolder="Buscar usuarios..."
               TexFromFilter="Usuarios"
               TexToFilter="@Filter"
               Callback=@OnFilterChangedAsync />
@if (IsLoading)
{
    <Loading />
}
else if (Applications == null || !Applications.Any())
{
    <div class="empty-state">
        @if (!string.IsNullOrWhiteSpace(Filter))
        {
            <div class="empty-state-icon">
                <i class="bi bi-search"></i> <!-- Icono de búsqueda (Bootstrap Icons) -->
            </div>
            <h3 class="empty-state-title">No se encontraron resultados</h3>
            <p class="empty-state-description">
                Ningún usuario coincide con: <span class="search-term">"@Filter"</span>.
                <br>Prueba con otros términos de búsqueda.
            </p>
        }
        else
        {
            <div class="empty-state-icon">
                <i class="bi bi-people"></i> <!-- Icono de usuarios -->
            </div>
            <h3 class="empty-state-title">Aún no hay aplicaciones</h3>
            <p class="empty-state-description">
                Ningún usuario se ha registrado para este evento.
                <br>Revisa más tarde o comparte el evento para aumentar el alcance.
            </p>
        }
    </div>
}
else
{
    <!-- Información del evento -->
    @if (Applications.First().Event != null)
    {
        <!-- Lista de aplicaciones -->
        <div class="card">
            <div class="card-header">
                <!-- Fila superior con título y botón -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        <i class="fa fa-calendar-alt"></i> @Applications.First().Event!.Name
                    </h5>
                    <button class="btn btn-secondary btn-sm" @onclick="GoBack">
                        <i class="fa fa-arrow-left"></i> Volver a Eventos
                    </button>
                </div>

                <!-- Contador destacado de asistentes -->
                <div class="attendance-counter-section mb-3">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="attendance-counter-card">
                                <div class="counter-icon">
                                    <i class="fa fa-check-circle"></i>
                                </div>
                                <div class="counter-content">
                                    <div class="counter-number">@(Statistics?.AttendedApplications ?? 0)</div>
                                    <div class="counter-label">Asistentes Confirmados</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-card">
                                <div class="stats-icon">
                                    <i class="fa fa-users"></i>
                                </div>
                                <div class="stats-content">
                                    <div class="stats-number">@(Statistics?.AcceptedApplications ?? 0)</div>
                                    <div class="stats-label">Aceptados</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-card">
                                <div class="stats-icon">
                                    <i class="fa fa-list"></i>
                                </div>
                                <div class="stats-content">
                                    <div class="stats-number">@(Statistics?.TotalApplications ?? 0)</div>
                                    <div class="stats-label">Total Postulaciones</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Usuario</th>
                                <th>Documento</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                                <th>Asistió?</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var application in Applications!)
                            {
                                <tr>
                                    <!-- Usuario -->
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(application.User?.Photo))
                                            {
                                                <img src="@application.User.Photo" alt="Foto"
                                                     class="rounded-circle me-3" style="width: 40px; height: 40px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3"
                                                     style="width: 40px; height: 40px;">
                                                    <i class="fa fa-user text-white"></i>
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-bold">@application.User?.FullName</div>
                                                <small class="text-muted">@application.User?.Email</small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Documento -->
                                    <td>
                                        <span class="badge bg-light text-dark">
                                            @application.User?.Document
                                        </span>
                                    </td>

                                    <!-- Teléfono -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(application.User?.PhoneNumber))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <a href="tel:@application.User.PhoneNumber"
                                                   class="text-decoration-none me-2"
                                                   title="Llamar">
                                                    <i class="fa fa-phone text-primary"></i>
                                                </a>
                                                <a href="https://wa.me/@(application.User.PhoneNumber.Replace("+", "").Replace("-", "").Replace(" ", ""))"
                                                   target="_blank"
                                                   class="text-decoration-none me-2"
                                                   title="Enviar WhatsApp">
                                                    <i class="fab fa-whatsapp text-success" style="font-size: 1.2em;"></i>
                                                </a>
                                                <span class="text-dark">@application.User.PhoneNumber</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No disponible</span>
                                        }
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(application.Status) fs-6">
                                            <i class="fa @GetStatusIcon(application.Status)"></i>
                                            @GetStatusText(application.Status)
                                        </span>
                                    </td>

                                    <!-- Acciones -->
                                    <td>
                                        @if (application.Status == ApplicationStatus.Pending)
                                        {
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-success btn-sm"
                                                        @onclick="() => UpdateApplicationStatusAsync(application.Id, ApplicationStatus.Accepted)"
                                                        title="Aceptar aplicación">
                                                    <i class="fa fa-check"></i> Aceptar
                                                </button>
                                                <button class="btn btn-danger btn-sm"
                                                        @onclick="() => UpdateApplicationStatusAsync(application.Id, ApplicationStatus.Rejected)"
                                                        title="Rechazar aplicación">
                                                    <i class="fa fa-times"></i> Rechazar
                                                </button>
                                            </div>
                                        }
                                        else if (application.Status == ApplicationStatus.Accepted)
                                        {
                                            <button class="btn btn-warning btn-sm"
                                                    @onclick="() => UpdateApplicationStatusAsync(application.Id, ApplicationStatus.Rejected)"
                                                    title="Cambiar a rechazado">
                                                <i class="fa fa-times"></i> Rechazar
                                            </button>
                                        }
                                        else if (application.Status == ApplicationStatus.Rejected)
                                        {
                                            <button class="btn btn-success btn-sm"
                                                    @onclick="() => UpdateApplicationStatusAsync(application.Id, ApplicationStatus.Accepted)"
                                                    title="Cambiar a aceptado">
                                                <i class="fa fa-check"></i> Aceptar
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="fa fa-ban"></i> Cancelado
                                            </span>
                                        }
                                    </td>

                                    <!-- Asistió? -->
                                    <td>
                                        @if (application.Status == ApplicationStatus.Accepted)
                                        {
                                            <div class="form-check form-switch d-flex align-items-center justify-content-center">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       role="switch"
                                                       id="attendance-@application.Id"
                                                       checked="@application.DidAttend"
                                                       @onchange="@((args) => UpdateAttendanceAsync(application.Id, (bool)args.Value!))"
                                                       style="transform: scale(1.2);">
                                                <label class="form-check-label ms-2"
                                                       for="attendance-@application.Id">
                                                    @if (application.DidAttend)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fa fa-check"></i> Asistió
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="fa fa-clock"></i> Pendiente
                                                        </span>
                                                    }
                                                </label>
                                            </div>
                                        }
                                        else if (application.Status == ApplicationStatus.Pending)
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fa fa-hourglass-half"></i> En revisión
                                            </span>
                                        }
                                        else if (application.Status == ApplicationStatus.Rejected)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa fa-times"></i> No aplica
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-muted">
                                                <i class="fa fa-ban"></i> Cancelado
                                            </span>
                                        }
                                    </td>

                                </tr>

                                <!-- Fila expandible para comentarios (si existen) -->
                                @if (!string.IsNullOrEmpty(application.AdminComments))
                                {
                                    <tr class="table-light">
                                        <td colspan="6">
                                            <div class="ps-4">
                                                <strong>Comentarios del administrador:</strong>
                                                <p class="mb-0 mt-1">@application.AdminComments</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Sección de paginacion -->
                <Pagination CurrentPage="CurrentPage"
                            TotalPages="TotalPages"
                            OnPageChanged="OnPageCngedAsync" />
            </div>
        </div>
    }
}

