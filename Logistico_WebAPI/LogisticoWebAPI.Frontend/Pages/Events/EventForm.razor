<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    
    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fa fa-calendar-plus"></i>
                @(EventDTO.Id == 0 ? "Crear Evento" : $"Editar Evento: {EventDTO.Name}")
            </h5>
        </div>
        
        <div class="card-body">
            <div class="row">
                <!-- Nombre del Evento -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre del Evento:</label>
                    <InputText class="form-control" @bind-Value="EventDTO.Name" />
                    <ValidationMessage For="@(() => EventDTO.Name)" />
                </div>
                
                <!-- Lugar del Evento -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Lugar del Evento:</label>
                    <InputText class="form-control" @bind-Value="EventDTO.Place" />
                    <ValidationMessage For="@(() => EventDTO.Place)" />
                </div>
            </div>
            
            <!-- Descripción del Evento -->
            <div class="mb-3">
                <label class="form-label">Descripción del Evento:</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="EventDTO.Description" />
                <ValidationMessage For="@(() => EventDTO.Description)" />
            </div>
            
            <div class="row">
                <!-- Fecha y Hora de Inicio -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha y Hora de Inicio:</label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="EventDTO.StartDate" />
                    <ValidationMessage For="@(() => EventDTO.StartDate)" />
                </div>
                
                <!-- Fecha y Hora de Fin -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha y Hora de Fin:</label>
                    <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="EventDTO.EndDate" />
                    <ValidationMessage For="@(() => EventDTO.EndDate)" />
                </div>
            </div>
            
            <div class="row">
                <!-- Tipo de Comida -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Tipo de Comida:</label>
                    <InputText class="form-control" @bind-Value="EventDTO.MealType" placeholder="Ej: Almuerzo, Cena, Refrigerio" />
                    <ValidationMessage For="@(() => EventDTO.MealType)" />
                </div>
                
                <!-- Pago por Persona -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Pago por Persona:</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <InputNumber class="form-control" @bind-Value="EventDTO.Payment" step="0.01" />
                    </div>
                    <ValidationMessage For="@(() => EventDTO.Payment)" />
                </div>
            </div>

            <!-- Foto del Evento -->
            <div class="mb-3">
                <h5 class="text-primary border-bottom pb-2">
                    <i class="fa fa-camera"></i> Foto del Evento
                </h5>

                <!-- Componente para seleccionar imagen -->
                <div class="text-center">
                    <InputImg Label="Seleccionar Foto del Evento" ImageSelected="ImageSelected" ImageURL="@imageUrl" />
                </div>

                <!-- Campo alternativo para URL (opcional) -->
                <div class="mt-3">
                    <label class="form-label">O ingresa una URL de imagen:</label>
                    <InputText class="form-control" @bind-Value="imageUrl" placeholder="https://ejemplo.com/foto-evento.jpg" />
                    <small class="text-muted">Si ingresas una URL, esta tendrá preferencia sobre la imagen seleccionada</small>
                </div>
            </div>
        </div>
        
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" @onclick="ReturnAction">
                    <i class="fa fa-arrow-left"></i> Cancelar
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save"></i>
                    @(EventDTO.Id == 0 ? "Crear Evento" : "Actualizar Evento")
                    @if(IsLoading)
                    {
                        <LoadingButton/>
                    }
                </button>
            </div>
        </div>
    </div>
</EditForm>


