@page "/events"

<h3>Eventos</h3>

@if (Events == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!Events.Any())
{
    <div class="alert alert-info">
        <h4>No hay eventos registrados</h4>
        <p>Aún no se han creado eventos en el sistema.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var eventItem in Events!)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(eventItem.Photo))
                    {
                        <img src="@eventItem.Photo" class="card-img-top" alt="@eventItem.Name" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fa fa-calendar-alt fa-3x text-white"></i>
                        </div>
                    }
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@eventItem.Name</h5>
                        <p class="card-text">@eventItem.Description</p>
                        
                        <div class="mt-auto">
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-map-marker-alt"></i> @eventItem.Place
                                    </small>
                                </div>
                            </div>
                            
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i> 
                                        Inicio: @eventItem.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            </div>
                            
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i> 
                                        Fin: @eventItem.FechaHoraFin.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(eventItem.MealType))
                            {
                                <div class="row mb-2">
                                    <div class="col">
                                        <small class="text-muted">
                                            <i class="fa fa-utensils"></i> @eventItem.MealType
                                        </small>
                                    </div>
                                </div>
                            }
                            
                            <div class="row mb-3">
                                <div class="col">
                                    <span class="badge bg-success fs-6">
                                        <i class="fa fa-dollar-sign"></i> @eventItem.Payment.ToString("C2")
                                    </span>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col">
                                    <button class="btn btn-primary btn-sm me-2">
                                        <i class="fa fa-eye"></i> Ver Detalles
                                    </button>
                                    <button class="btn btn-success btn-sm">
                                        <i class="fa fa-user-plus"></i> Inscribirse
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
