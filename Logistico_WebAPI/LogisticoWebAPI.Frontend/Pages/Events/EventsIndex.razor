@page "/events"

<div class="d-flex justify-content-between align-items-center mb-3">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <a class="btn btn-primary" href="/events/create">
                <i class="fa fa-plus"></i> Crear Evento
            </a>
        </Authorized>
    </AuthorizeView>
</div>

<!-- Sección de Filtro -->
<GenericFilter PlaceHolder="Buscar eventos por nombre..."
               TexFromFilter="Buscar Eventos"
               TexToFilter="@Filter"
               Callback=@OnFilterChangedAsync />

@if (IsLoading)
{
    <Loading />
}
else if (Events == null || !Events.Any())
{
    <div class="empty-state">
        @if (!string.IsNullOrWhiteSpace(Filter))
        {
            <div class="empty-state-icon">
                <i class="bi bi-calendar-x"></i> <!-- Icono de calendario con X -->
            </div>
            <h3 class="empty-state-title">Eventos no encontrados</h3>
            <p class="empty-state-description">
                Ningún evento coincide con: <span class="search-term">"@Filter"</span>.
                <br>Prueba con otros términos de búsqueda.
            </p>
        }
        else
        {
            <div class="empty-state-icon">
                <i class="bi bi-calendar-plus"></i> <!-- Icono de calendario con + -->
            </div>
            <h3 class="empty-state-title">No hay eventos disponibles</h3>
            <p class="empty-state-description">
                El sistema no tiene eventos registrados actualmente.

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <br>Comienza creando el primer evento ahora mismo.
                        <a class="btn btn-primary" href="/events/create">
                            <i class="fa fa-plus"></i> Crear Evento
                        </a>
                    </Authorized>
                </AuthorizeView>
            </p>
        }
    </div>
}
else
{
    <div class="row">
        @foreach (var eventItem in Events!)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(eventItem.Photo))
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center" style="height: 200px; background-color: #f8f9fa; overflow: hidden;">
                            <img src="@eventItem.Photo" alt="@eventItem.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                        </div>
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fa fa-calendar-alt fa-3x text-white"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@eventItem.Name</h5>
                        <p class="card-text">@eventItem.Description</p>

                        <div class="mt-auto">
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-map-marker-alt"></i> @eventItem.Place
                                    </small>
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i>
                                        Inicio: @eventItem.StartDate.ToString("dddd dd 'de' MMMM 'de' yyyy, h:mm tt")
                                    </small>
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i>
                                        Fin: @eventItem.EndDate.ToString("dddd dd 'de' MMMM 'de' yyyy, h:mm tt") aprox.
                                    </small>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(eventItem.MealType))
                            {
                                <div class="row mb-2">
                                    <div class="col">
                                        <small class="text-muted">
                                            <i class="fa fa-utensils"></i> @eventItem.MealType
                                        </small>
                                    </div>
                                </div>
                            }

                            <div class="row mb-3">
                                <div class="col">
                                    <span class="badge bg-success fs-6">
                                        <i class="fa fa-dollar-sign"></i> @eventItem.Payment.ToString("C2")
                                    </span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                                        <AuthorizeView Roles="User">
                                            <Authorized>
                                                @if (HasAppliedToEvent(eventItem.Id))
                                                {
                                                    <button class="btn btn-secondary btn-sm" disabled>
                                                        <i class="fa fa-check"></i> Postulado
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-success btn-sm"
                                                            @onclick="() => AppyToEventAsync(eventItem.Id)">
                                                        <i class="fa fa-user-plus"></i> Postularme
                                                    </button>
                                                }
                                            </Authorized>
                                        </AuthorizeView>
                                        <AuthorizeView Roles="Admin">
                                            <Authorized>
                                                <a class="btn btn-info btn-sm"
                                                   href="/events/applications/@eventItem.Id">
                                                    <i class="fa fa-users"></i> Postulaciones
                                                </a>
                                                <a class="btn btn-warning btn-sm" href="/events/edit/@eventItem.Id">
                                                    <i class="fa fa-edit"></i> Editar
                                                </a>
                                                <button class="btn btn-danger btn-sm"
                                                        @onclick="() => DeleteAsync(eventItem)">
                                                    <i class="fa fa-trash"></i> Borrar
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <Pagination CurrentPage="CurrentPage"
                TotalPages="TotalPages"
                OnPageChanged="OnPageCngedAsync" />
}
<style>
    .empty-state {
        text-align: center;
        padding: 2rem;
        margin: 2rem auto;
        max-width: 500px;
    }

    .empty-state-icon {
        font-size: 3rem;
        color: #6c757d;
        margin-bottom: 1rem;
    }

    .empty-state-title {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .empty-state-description {
        color: #6c757d;
        margin-bottom: 1.5rem;
    }

    .search-term {
        font-weight: 600;
        color: #333;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        margin: 2rem auto;
        max-width: 500px;
    }
</style>