@page "/events"

<h3>Eventos</h3>

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="mb-3">
            <a class="btn btn-primary" href="/events/create">
                <i class="fa fa-plus"></i> Crear Evento
            </a>
        </div>
    </Authorized>
</AuthorizeView>

@if (Events == null)
{
    <Loading />
}
else if (!Events.Any())
{
    <div class="alert alert-info">
        <h4>No hay eventos registrados</h4>
        <p>Aún no se han creado eventos en el sistema.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var eventItem in Events!)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(eventItem.Photo))
                    {
                        <img src="@eventItem.Photo" class="card-img-top" alt="@eventItem.Name" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fa fa-calendar-alt fa-3x text-white"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@eventItem.Name</h5>
                        <p class="card-text">@eventItem.Description</p>

                        <div class="mt-auto">
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-map-marker-alt"></i> @eventItem.Place
                                    </small>
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i>
                                        Inicio: @eventItem.StartDate.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            </div>

                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i>
                                        Fin: @eventItem.EndDate.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(eventItem.MealType))
                            {
                                <div class="row mb-2">
                                    <div class="col">
                                        <small class="text-muted">
                                            <i class="fa fa-utensils"></i> @eventItem.MealType
                                        </small>
                                    </div>
                                </div>
                            }

                            <div class="row mb-3">
                                <div class="col">
                                    <span class="badge bg-success fs-6">
                                        <i class="fa fa-dollar-sign"></i> @eventItem.Payment.ToString("C2")
                                    </span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">
                                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                                        @if (HasAppliedToEvent(eventItem.Id))
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled>
                                                <i class="fa fa-check"></i> Postulado
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-success btn-sm"
                                                    @onclick="() => AppyToEventAsync(eventItem.Id)">
                                                <i class="fa fa-user-plus"></i> Postularme
                                            </button>
                                        }

                                        <AuthorizeView Roles="Admin">
                                            <Authorized>
                                                <a class="btn btn-info btn-sm">
                                                    <i class="fa fa-users"></i> Aplicaciones
                                                </a>
                                                <button class="btn btn-primary btn-sm">
                                                    <i class="fa fa-eye"></i> Ver Detalles
                                                </button>
                                                <a class="btn btn-warning btn-sm" href="/events/edit/@eventItem.Id">
                                                    <i class="fa fa-edit"></i> Editar
                                                </a>
                                                <button class="btn btn-danger btn-sm"
                                                        @onclick="() => DeleteAsync(eventItem)">
                                                    <i class="fa fa-trash"></i> Borrar
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
