@page "/myapplications"

@if (Applications == null)
{
    <Loading />
}
else if (!Applications.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-person-x"></i> <!-- Icono de persona con X -->
        </div>
        <h3 class="empty-state-title">No tienes postulaciones registradas</h3>
        <p class="empty-state-description">
            Aún no te has postulado a ningún evento.
            <br>¡Explora los eventos y encuentra oportunidades perfectas para ti!
        </p>
        <div class="empty-state-actions">
            <a class="btn btn-primary btn-lg" href="/events">
                <i class="fa fa-search"></i> Explorar Eventos
            </a>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var application in Applications!)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(application.Event?.Photo))
                    {
                        <img src="@application.Event.Photo" class="card-img-top" alt="@application.Event.Name" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fa fa-calendar-alt fa-3x text-white"></i>
                        </div>
                    }
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@application.Event?.Name</h5>
                        <p class="card-text">@application.Event?.Description</p>
                        
                        <div class="mt-auto">
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-map-marker-alt"></i> @application.Event?.Place
                                    </small>
                                </div>
                            </div>
                            
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i>
                                        Inicio: @application.Event?.StartDate.ToString("dddd dd 'de' MMMM 'de' yyyy, h:mm tt")
                                    </small>
                                </div>
                            </div>
                            
                            <div class="row mb-2">
                                <div class="col">
                                    <small class="text-muted">
                                        <i class="fa fa-clock"></i>
                                        Fin: @application.Event?.EndDate.ToString("dddd dd 'de' MMMM 'de' yyyy, h:mm tt") aprox.
                                    </small>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(application.Event?.MealType))
                            {
                                <div class="row mb-2">
                                    <div class="col">
                                        <small class="text-muted">
                                            <i class="fa fa-utensils"></i> @application.Event.MealType
                                        </small>
                                    </div>
                                </div>
                            }
                            
                            <div class="row mb-3">
                                <div class="col">
                                    <span class="badge bg-success fs-6">
                                        <i class="fa fa-dollar-sign"></i> @application.Event?.Payment.ToString("C2")
                                    </span>
                                </div>
                            </div>

                            <!-- Estado de la aplicación -->
                            <div class="row mb-3">
                                <div class="col">
                                    <span class="badge @GetStatusBadgeClass(application.Status) fs-6">
                                        <i class="fa @GetStatusIcon(application.Status)"></i> @GetStatusText(application.Status)
                                    </span>
                                </div>
                            </div>

                            <!-- Comentarios del administrador -->
                            @if (!string.IsNullOrEmpty(application.AdminComments))
                            {
                                <div class="row mb-3">
                                    <div class="col">
                                        <div class="alert alert-info">
                                            <small>
                                                <strong>Comentarios del administrador:</strong><br />
                                                @application.AdminComments
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Botones de acción -->
                            <div class="row">
                                <div class="col">
                                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                                        @if (application.Status == ApplicationStatus.Pending || application.Status == ApplicationStatus.Accepted)
                                        {
                                            <button class="btn btn-danger btn-sm"
                                                    @onclick="() => CancelApplicationAsync(application.EventId)">
                                                <i class="fa fa-times"></i> Cancelar Aplicación
                                            </button>
                                        }
                                        
                                        <a class="btn btn-info btn-sm" href="/events">
                                            <i class="fa fa-arrow-left"></i> Ver más eventos
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        margin: 2rem auto;
        max-width: 600px;
    }

    .empty-state-icon {
        font-size: 4rem;
        color: #6c757d;
        margin-bottom: 1.5rem;
    }

    .empty-state-title {
        font-weight: 600;
        font-size: 1.75rem;
        margin-bottom: 1rem;
        color: #495057;
    }

    .empty-state-description {
        color: #6c757d;
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .empty-state-actions {
        margin-top: 1.5rem;
    }

    .empty-state .btn-lg {
        padding: 12px 30px;
        font-weight: 500;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .empty-state .btn-lg:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
        }
</style>