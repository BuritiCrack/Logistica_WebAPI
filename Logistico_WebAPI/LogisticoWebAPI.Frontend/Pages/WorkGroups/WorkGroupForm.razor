<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fa fa-users"></i>
                @(WorkGroupDTO.Id == 0 ? "Crear Grupo de Trabajo" : $"Editar Grupo de Trabajo: {WorkGroupDTO.Name}")
            </h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Nombre del Grupo de Trabajo:</label>
                <InputText class="form-control" @bind-Value="WorkGroupDTO.Name" />
                <ValidationMessage For="@(() => WorkGroupDTO.Name)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción del Grupo de Trabajo:</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="WorkGroupDTO.Description" />
                <ValidationMessage For="@(() => WorkGroupDTO.Description)" />
            </div>
        </div>

        <AuthorizeView Roles="Admin, SuperAdmin">
            <Authorized Context="auth">
                <div class="mb-3">
                    <label class="form-label">Coordinador del Grupo: <span class="text-danger">*</span></label>

                    @if (IsLoadingCoordinator)
                    {
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <span>Cargando coordinadores...</span>
                        </div>
                    }
                    else if (Coordinators == null || !Coordinators.Any())
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="fa fa-exclamation-triangle"></i>
                            No hay coordinadores aprobados en este evento.
                        </div>
                    }
                    else
                    {
                        <InputSelect class="form-select" @bind-Value="WorkGroupDTO.CoordinatorId">
                            <option value="">-- Seleccione un coordinador --</option>
                            @foreach (var coordinator in Coordinators)
                            {
                                <option value="@coordinator.Id">@coordinator.FullName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => WorkGroupDTO.CoordinatorId)" />
                    }
                </div>
            </Authorized>
        </AuthorizeView>
        <div class="card-footer text-end">
            <div class="d-flex justify-content-between">
                <button type="button" class="btn btn-secondary" @onclick="ReturnAction">
                    <i class="fa fa-arrow-left"></i> Volver
                </button>

                @if (WorkGroupDTO.Id == 0)
                {
                    <LoadingButton IsLoading="IsLoading"
                                   Text="Crear Grupo de Trabajo"
                                   LoadingText="Creando..."
                                   Icon="fa fa-save"
                                   ButtonType="submit"
                                   CssClass="btn btn-primary" />
                }
                else
                {
                    <LoadingButton IsLoading="IsLoading"
                                   Text="Actualizar Grupo de Trabajo"
                                   LoadingText="Actualizando..."
                                   Icon="fa fa-save"
                                   ButtonType="submit"
                                   CssClass="btn btn-primary" />
                }
            </div>
        </div>
    </div>
</EditForm>

